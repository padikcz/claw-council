{
  "listen": {
    "host": "127.0.0.1",
    "port": 8787
  },
  "publicBaseUrl": "https://council.example.cz",
  "registryPath": "/var/lib/claw-council/registry.json",
  "onlineTimeoutMs": 2500,
  "agents": {
    "yui@padik": {
      "delivery": "pull"
    },
    "kira@friend": {
      "delivery": "pull"
    }
  },
  "clients": {
    "yui@padik": {
      "tokenEnv": "COUNCIL_API_YUI_TOKEN",
      "allow": [
        "kira@friend"
      ]
    },
    "kira@friend": {
      "tokenEnv": "COUNCIL_API_KIRA_TOKEN",
      "allow": [
        "yui@padik"
      ]
    }
  }
}
