{
  agents: {
    entries: {
      council: {
        name: "Council",
        workspace: "/absolute/path/to/workspace-council",
        tools: {
          allow: [],
        },
      },
    },
  },

  // Route every authenticated ClawCouncil A2A request to the isolated agent.
  bindings: [
    {
      agentId: "council",
      match: {
        channel: "a2a",
        peer: { kind: "direct", id: "claw-council" },
      },
    },
  ],

  channels: {
    a2a: {
      enabled: true,
      advertisedUrl: "https://yui.example.cz",
      exposeAgents: ["council"],
      peers: {
        "claw-council": {
          token: "${COUNCIL_A2A_TOKEN}",
        },
      },
    },
  },

  plugins: {
    entries: {
      "claw-council": {
        enabled: true,
        config: {
          baseUrl: "https://council.example.cz",
          token: "${COUNCIL_API_TOKEN}",
        },
      },
    },
  },
}
