{
  agents: {
    entries: {
      council: {
        name: "Council",
        workspace: "/absolute/path/to/workspace-council",
        tools: {
          allow: [],
        },
      },
    },
  },

  plugins: {
    entries: {
      "claw-council": {
        enabled: true,
        config: {
          baseUrl: "https://council.example.cz",
          token: "${COUNCIL_API_TOKEN}",
          localAgentId: "council",
          pollIntervalMs: 2000,
        },
      },
    },
  },
}
