{
  "name": "claw-council",
  "version": "0.4.2",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/padikcz/claw-council.git"
  },
  "homepage": "https://github.com/padikcz/claw-council#readme",
  "bugs": {
    "url": "https://github.com/padikcz/claw-council/issues"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @claw-council/openclaw-plugin",
    "test": "node --test test/*.test.mjs && npm run test -w @claw-council/hub && npm run test -w @claw-council/openclaw-plugin",
    "start": "npm run start -w @claw-council/hub",
    "pack:plugin": "npm run build -w @claw-council/openclaw-plugin && npm pack -w @claw-council/openclaw-plugin",
    "join": "node scripts/join-openclaw.mjs",
    "enable:auto-update": "node scripts/auto-update.mjs"
  },
  "engines": {
    "node": ">=24.16"
  }
}
